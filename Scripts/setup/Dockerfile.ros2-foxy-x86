FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

SHELL ["/bin/bash", "-c"]

# Base dependencies and locale configuration
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       apt-transport-https \
       build-essential \
       ca-certificates \
       curl \
       gnupg \
       locales \
       lsb-release \
       python3-argcomplete \
       python3-colcon-common-extensions \
       python3-pip \
       python3-rosdep \
       software-properties-common \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 repository and key
RUN mkdir -p /usr/share/keyrings \
    && curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
       | gpg --dearmor > /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu focal main" \
       > /etc/apt/sources.list.d/ros2.list

# Install ROS 2 Foxy
RUN apt-get update \
    && apt-get install -y --no-install-recommends ros-foxy-desktop \
    && rm -rf /var/lib/apt/lists/*

# Initialize rosdep for container usage
RUN rosdep init \
    && rosdep update

# Default to sourcing ROS 2 setup
RUN echo "source /opt/ros/foxy/setup.bash" >> /etc/bash.bashrc

CMD ["bash"]
