<?xml version="1.0"?>
<package format="3">
  <name>admit14_camera</name>
  <version>0.1.0</version>
  <description>Camera publishers and visualisers for the Admit 14 tutorials.</description>
  <maintainer email="maintainer@example.com">Admit14</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ultralytics</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
